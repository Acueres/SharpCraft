<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
    
    <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.512.0" />
    <PackageReference Include="StbiSharp" Version="1.2.1" />
    </ItemGroup>

	<ItemGroup>
		<None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="CompileShaders" BeforeTargets="BeforeBuild">
		<Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../ShaderCompiler/ShaderCompiler.csproj&quot; -- &quot;$(MSBuildProjectDirectory)&quot; &quot;$(TargetDir).&quot;" />
	</Target>
</Project>